# Telegram
BOT_TOKEN=
CHAT_ID=

# Telegraph
TELEGRAPH_TOKEN=
USE_TELEGRAPH=0

# Scheduling
FETCH_INTERVAL_MIN=40
SEND_INTERVAL_MIN=10
MAX_AGE_DAYS=30
TIMEZONE=America/Sao_Paulo
SEND_WINDOW_START=08:00
SEND_WINDOW_END=22:00

# When queue is empty, how often to check again (seconds)
IDLE_POLL_SEC=20

# Behavior
DRY_RUN=0
LOG_LEVEL=INFO
MAX_ITEMS_PER_FETCH=120
MAX_ITEMS_PER_QUERY=10

# Envio
# Se 1, nunca envia notícia sem imagem.
REQUIRE_IMAGE=1
# Se 1, quando não achar imagem no artigo, busca uma imagem relacionada no Wikimedia Commons.
IMAGE_FALLBACK=1

# Optional: override queries (comma-separated). If empty, defaults are used.
QUERIES=
